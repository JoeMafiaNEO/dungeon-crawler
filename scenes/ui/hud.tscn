[connection signal="pressed" from="ClassPanel/ClassVBox/MageBtn" to="." method="_on_class_chosen" binds=["mage"]]
[connection signal="pressed" from="ClassPanel/ClassVBox/ClassCancel" to="." method="_on_class_cancel"]
[connection signal="pressed" from="PausePanel/PauseScroll/PauseVBox/StatPair1/DmgRow/DmgPlus" to="." method="_on_stat_pressed" binds=["damage"]]
[connection signal="pressed" from="PausePanel/PauseScroll/PauseVBox/StatPair1/HpRow/HpPlus" to="." method="_on_stat_pressed" binds=["health"]]
[connection signal="pressed" from="PausePanel/PauseScroll/PauseVBox/StatPair2/SpdRow/SpdPlus" to="." method="_on_stat_pressed" binds=["speed"]]
[connection signal="pressed" from="PausePanel/PauseScroll/PauseVBox/StatPair2/AuraRow/AuraPlus" to="." method="_on_stat_pressed" binds=["aura"]]
[connection signal="pressed" from="InventoryPanel/InvVBox/DisposeButton" to="." method="_on_dispose_pressed"]
[connection signal="pressed" from="InventoryPanel/InvVBox/UseButton" to="." method="_on_use_pressed"]
[connection signal="pressed" from="TopRight/NextWaveButton" to="." method="_on_next_wave_pressed"]
[connection signal="pressed" from="DeathPanel/DeathVBox/QuickRestartButton" to="." method="_on_quick_restart_pressed"]
[connection signal="pressed" from="DeathPanel/DeathVBox/DeathMenuButton" to="." method="_on_death_menu_pressed"]
